# Servidor SQL del proyecto. Copiar a .env y completar la contraseña localmente.
SQL_SERVER=10.6.16.10
SQL_DATABASE=ControlDeApuntes
SQL_USER=sa
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true
PORT=3188
# Para usar LocalDB: SQL_SERVER=(localdb)\ApuntesLocal,
# SQL_USER y SQL_PASSWORD vacíos, SQL_ENCRYPT=false.
# Opcional: carpeta de backup en el servidor SQL (no es una ruta del navegador).
# SQL_BACKUP_DIRECTORY=D:\SQLBackups
